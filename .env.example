# CloudPulse environment variables
# Copy to .env and fill in your values (never commit .env to git)

# ── AWS ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2

# ── Azure ─────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Deployment ───────────────────────────────────────────────
IMAGE_TAG=latest
